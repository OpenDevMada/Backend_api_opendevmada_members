# Server configuration
NODE_ENV=development
PORT=8000

# Database configuration
# Options: sqlite3 (default) or mysql2
DB_CLIENT=sqlite3
SQLITE_PATH=./storage/database.sqlite

# MySQL credentials (used when DB_CLIENT=mysql2)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=opendevmad_db

# CORS configuration
# Comma separated list of allowed origins, use * to allow all
CORS_ORIGINS=*
